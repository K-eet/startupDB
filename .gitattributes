# Normalize line endings: store text as LF in the repo and check out as LF,
# regardless of the contributor's OS/editor. Prevents the whole-file CRLF
# "phantom diff" noise this repo saw before this file existed.
* text=auto eol=lf

# Binary assets — never apply line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
