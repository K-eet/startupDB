rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Companies collection - public read, authenticated write
    match /companies/{companyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // VC Firms collection - public read, authenticated write
    match /vcFirms/{firmId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Events collection - public read, authenticated write
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
