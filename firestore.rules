rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['keetm.lee@gmail.com'];
    }

    // Companies collection - public read, admin write
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // VC Firms collection - public read, admin write
    match /vcFirms/{firmId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events collection - public read, admin write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
